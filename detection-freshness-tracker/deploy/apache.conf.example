# Apache vhost for running Detection Rule Freshness Tracker on a subdomain,
# on a VPS where Apache already serves your main domain (and owns 80/443).
#
# Setup:
#   1. Point this subdomain's DNS A/AAAA record at this VPS.
#   2. On the VPS: enable the modules this needs (once):
#        sudo a2enmod proxy proxy_http headers ssl
#   3. Copy this file, replacing detect.example.com with your real subdomain:
#        sudo cp deploy/apache.conf.example /etc/apache2/sites-available/detect.example.com.conf
#        sudo sed -i 's/detect.example.com/YOUR-SUBDOMAIN/g' /etc/apache2/sites-available/detect.example.com.conf
#   4. sudo a2ensite detect.example.com && sudo systemctl reload apache2
#   5. Get a cert - certbot's apache plugin finds this vhost by ServerName
#      and rewrites this file to add the matching :443 block + a redirect
#      from :80, so you do NOT need to hand-write TLS config here:
#        sudo certbot --apache -d detect.example.com
#   6. Bring up the app stack itself (see README.md - use
#      docker-compose.local-proxy.yml, NOT docker-compose.caddy.yml,
#      since Apache is already holding 80/443 on this box):
#        docker compose -f docker-compose.yml -f docker-compose.local-proxy.yml up -d --build
#
# The app container publishes to 127.0.0.1:8010 by default (see
# docker-compose.local-proxy.yml / API_HOST_PORT in .env) - change the port
# below to match if you changed API_HOST_PORT.

<VirtualHost *:80>
    ServerName detect.example.com

    ProxyPreserveHost On
    ProxyPass / http://127.0.0.1:8010/
    ProxyPassReverse / http://127.0.0.1:8010/

    RequestHeader set X-Forwarded-Proto "http"

    ErrorLog ${APACHE_LOG_DIR}/detect.example.com-error.log
    CustomLog ${APACHE_LOG_DIR}/detect.example.com-access.log combined
</VirtualHost>
