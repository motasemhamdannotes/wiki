# ---- Core ----
# Public hostname the portal will be served on, e.g. detect.yourdomain.com
# Only actually used by docker-compose.caddy.yml (the standalone-Caddy
# path) to request a TLS cert. Harmless to leave set either way.
SITE_DOMAIN=detect.example.com
# Used for building canonical links, RSS, etc.
SITE_URL=https://detect.example.com

# Host port the api container publishes to 127.0.0.1 when using
# docker-compose.local-proxy.yml (deploying behind an existing nginx/Apache/
# other web server on this VPS). Not used by docker-compose.caddy.yml.
API_HOST_PORT=8010

# ---- Database ----
POSTGRES_USER=detection_tracker
POSTGRES_PASSWORD=change-me-before-deploying
POSTGRES_DB=detection_tracker
# Full DSN the app connects with. In docker-compose this points at the "db" service.
DATABASE_URL=postgresql+psycopg://detection_tracker:change-me-before-deploying@db:5432/detection_tracker

# ---- Rule sources (git URLs, rarely need to change) ----
SIGMA_REPO_URL=https://github.com/SigmaHQ/sigma.git
SIGMA_REPO_BRANCH=master
SIGMA_RULES_SUBDIRS=rules,rules-emerging-threats,rules-threat-hunting

ELASTIC_REPO_URL=https://github.com/elastic/detection-rules.git
ELASTIC_REPO_BRANCH=main
ELASTIC_RULES_SUBDIRS=rules

SPLUNK_REPO_URL=https://github.com/splunk/security_content.git
SPLUNK_REPO_BRANCH=develop
SPLUNK_RULES_SUBDIRS=detections

# Where the worker keeps its local clones (a Docker volume in docker-compose)
GIT_CACHE_DIR=/data/repos

# ---- Enrichment sources ----
# Optional. Without a key, NVD limits you to 5 requests/30s (still plenty for this
# app's polling cadence). Get one free at https://nvd.nist.gov/developers/request-an-api-key
NVD_API_KEY=
CISA_KEV_URL=https://www.cisa.gov/sites/default/files/feeds/known_exploited_vulnerabilities.json
ATTACK_STIX_URL=https://raw.githubusercontent.com/mitre-attack/attack-stix-data/master/enterprise-attack/enterprise-attack.json

# ---- Scheduling (minutes) ----
RULES_POLL_INTERVAL_MINUTES=120
NVD_RECENT_POLL_INTERVAL_MINUTES=180
KEV_POLL_INTERVAL_MINUTES=720
ATTACK_POLL_INTERVAL_HOURS=168

# How many days back to pull "recent CVEs" from NVD for the coverage-gap view
NVD_LOOKBACK_DAYS=30

# ---- Misc ----
LOG_LEVEL=INFO
# Set true only for local dev without HTTPS in front
DEV_MODE=false
